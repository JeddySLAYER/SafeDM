# Application
APP_NAME=SafeDM
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# PostgreSQL (installation locale — pas de Docker)
DATABASE_URL=postgresql+psycopg2://safedm:safedm@localhost:5432/safedm

# CORS — origines autorisées (mobile / dashboard)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini 2.5 Flash (backend uniquement — ne jamais exposer au mobile)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# VirusTotal (backend uniquement)
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3

# Timeouts (secondes)
GEMINI_TIMEOUT_SECONDS=30
VIRUSTOTAL_TIMEOUT_SECONDS=30
