# Application
APP_NAME=SafeDM
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Base de données — trois options, une seule active (celle sans #)

# A) Neon (hébergé, recommandé pour le partage)
# Copier la connection string « pooled » depuis le dashboard Neon (hôte avec -pooler).
# Garder sslmode=require. Si psycopg2 rejette channel_binding=require, retirer
# uniquement ce paramètre de l'URL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# B) Docker local (recommandé en dev) — docker compose up -d
# DATABASE_URL=postgresql+psycopg2://safedm:safedm@localhost:55432/safedm

# C) PostgreSQL système (si déjà installé)
# DATABASE_URL=postgresql+psycopg2://safedm:safedm@localhost:5432/safedm

# URLs superuser locales pour scripts/ensure_database.py (optionnel, séparées par des virgules)
# PGADMIN_URLS=postgresql+psycopg2://postgres:postgres@localhost:5432/postgres

# CORS — dashboard Vite + variantes 127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Jev (System One / TypeSafe) — remplit Gemini en V2.
# Jev n'est appele que sur escalade consentie : jamais en automatique sur chaque SMS.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=15
TYPESAFE_MAX_CONTENT_CHARS=6000

# VirusTotal
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
VIRUSTOTAL_TIMEOUT_SECONDS=30

# Mode demo local sans cles API (dev uniquement)
ANALYSIS_DEMO_MODE=true

# --- Seuils de decision (politique produit) -------------------------------
# Recales par le benchmark Sprint 10 (28 SMS francais/togolais).
# A toucher seulement apres avoir rejoue scripts/benchmark_jev.py.

# En dessous, un verdict SAFE de Jev est degrade en PARTIAL : un juge peu sur
# de lui ne rehabilite jamais un message. 0.40 ne couvrait que 3 erreurs sur 14 ;
# 0.65 en couvre 7 pour 9 messages escalades sur 28.
THRESHOLD_UNCERTAINTY_CONFIDENCE=0.65
# Au-dessus, le mobile tranche seul. En dessous, on propose le consentement Jev.
THRESHOLD_ESCALATION_CONFIDENCE=0.65

# Bornes de score qui font basculer le statut final.
THRESHOLD_SAFE_SCORE=35
THRESHOLD_SUSPICIOUS_SCORE=65
THRESHOLD_CRITICAL_SCORE=85

# Plancher impose quand on degrade un resultat (juge incertain, source KO).
UNCERTAIN_SCORE_FLOOR=40
# Base64 PEM RSA key used only by the weekly manifest job; keep in Secret Manager.
MODEL_PATCH_SIGNING_KEY_PEM_B64=
MODEL_PATCH_ARTIFACT_SHA256=
