# Copy these values into Secret Manager / Cloud Run environment configuration.
APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
SECRET_KEY=generate-a-long-random-value
TYPESAFE_API_KEY=secret://typesafe-api-key
FINGERPRINT_PRIVATE_KEY_PEM_B64=secret://fingerprint-private-key
MODEL_PATCH_SIGNING_KEY_PEM_B64=secret://model-manifest-signing-key
MODEL_PATCH_ARTIFACT_SHA256=sha256-of-the-tflite-artifact
MODEL_PATCH_URL=https://storage.googleapis.com/BUCKET/models/safedm_v3.tflite
MODEL_PATCH_MANIFEST_PATH=/app/artifacts/weekly/latest.json
