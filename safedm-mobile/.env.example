# Base URL de l'API SafeDM (injectée dans app.config.js → Constants.expoConfig.extra)
# Emulateur Android : http://10.0.2.2:8000/api/v1
# Device physique : IP LAN du PC (ex. http://192.168.1.20:8000/api/v1)
# Cloud / release : HTTPS obligatoire (sauf localhost)
API_BASE_URL=https://safedm-backend.fastapicloud.dev/api/v1

# development | production — cleartext HTTP autorisé seulement hors production
APP_ENV=development

# Optionnel : URI modèle TFLite OTA (sinon asset bundle)
# LOCAL_MODEL_URI=

# RSA SPKI base64 — enveloppe fingerprint / analysis/features (sinon soft-fail UI)
# FINGERPRINT_PUBLIC_KEY=

# Clé publique ECDSA — vérification manifests OTA modèle (sinon OTA désactivée)
# MODEL_MANIFEST_PUBLIC_KEY=
